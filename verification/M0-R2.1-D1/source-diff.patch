+                            && abandonResult == WorldEffectLedger.AbandonResult.ABANDONED));
+        } finally {
+            start.countDown();
+            executor.shutdownNow();
+            assertTrue(executor.awaitTermination(10, TimeUnit.SECONDS));
+        }
+    }
