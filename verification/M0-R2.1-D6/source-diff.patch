@@ -0,0 +1,110 @@
+package dev.coldatomcraft.physics.optics;
+
+import dev.coldatomcraft.physics.Vec3;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+
+/**
+ * Optical field superposition, separate from the Minecraft world.
+ *
+ * <p>Fully coherent sources must share the exact vacuum carrier wavelength,
+ * a single physical phase origin and a matching phaseReferenceKey. Otherwise
+ * optical beating/time averaging is outside this model. The scalar quantity
+ * |F|^2 is 2c times the cycle-averaged ELECTRIC energy density, NOT net
+ * transmitted power for standing waves. The magnetic term is distinct. The leading-order paraxial Poynting vector is returned
+ * separately.</p>
+ */
+public final class CoherentOptics {
+    public static final double VACUUM_LIGHT_SPEED_METERS_PER_SECOND = 299_792_458.0;
+    private CoherentOptics() {}
+
+    /** Fields use sqrt(W/m^2) normalization; H = sum(k_hat x F) in that scale. */
+    public record Result(VectorFieldPhasor electric, VectorFieldPhasor normalizedMagnetic) {
+        public Result {
+            if (electric == null || normalizedMagnetic == null) {
+                throw new IllegalArgumentException("electric/magnetic fields required");
+            }
+        }
+
+        public double electricIntensityEquivalentWattsPerSquareMeter() {
+            return electric.electricIntensityEquivalentWattsPerSquareMeter();
+        }
+
+        /** Cycle-averaged electric energy density epsilon0*|E_peak|^2/4. */
+        public double electricEnergyDensityJoulesPerCubicMeter() {
+            return electric.electricIntensityEquivalentWattsPerSquareMeter()
+                    / (2 * VACUUM_LIGHT_SPEED_METERS_PER_SECOND);
+        }
+
+        /** Cycle-averaged magnetic energy density B_peak^2/(4*mu0). */
+        public double magneticEnergyDensityJoulesPerCubicMeter() {
+            return normalizedMagnetic.electricIntensityEquivalentWattsPerSquareMeter()
+                    / (2 * VACUUM_LIGHT_SPEED_METERS_PER_SECOND);
+        }
+
+        /** Leading-order total electromagnetic energy density. */
+        public double totalEnergyDensityJoulesPerCubicMeter() {
+            return electricEnergyDensityJoulesPerCubicMeter()
+                    + magneticEnergyDensityJoulesPerCubicMeter();
+        }
+
+        /** Leading-order paraxial, time-averaged Poynting vector [W/m^2]. */
+        public Vec3 timeAveragePoyntingWattsPerSquareMeter() {
+            return electric.averagePoyntingWith(normalizedMagnetic);
+        }
+    }
+
+    /** Coherently sum electric and normalized magnetic phasors at one lab point. */
+    public static Result coherentAtLabPoint(Vec3 pointMeters, List<JonesGaussianBeam> beams) {
+        if (pointMeters == null) throw new IllegalArgumentException("sample point required");
+        validateNonemptyUniqueBeams(beams);
+        String reference = beams.get(0).phaseReferenceKey();
+        double wavelength = beams.get(0).beam().vacuumWavelengthMeters();
+        VectorFieldPhasor e = VectorFieldPhasor.ZERO;
+        VectorFieldPhasor h = VectorFieldPhasor.ZERO;
+        for (JonesGaussianBeam beam : beams) {
+            if (!reference.equals(beam.phaseReferenceKey())
+                    || Double.compare(wavelength, beam.beam().vacuumWavelengthMeters()) != 0) {
+                throw new IllegalArgumentException("coherent beams require matching phase reference and carrier wavelength");
+            }
+            VectorFieldPhasor sample = beam.sampleAtLabPoint(pointMeters);
+            e = e.plus(sample);
+            h = h.plus(sample.directionCross(beam.beam().directionLab()));
+        }
+        return new Result(e, h);
+    }
+
+    /**
+     * Time/ensemble-averaged electric intensity equivalent for independent
+     * phase reference groups. Different wavelengths are permitted here.
+     * Deliberately rejects two beams from the SAME declared coherence group.
+     */
+    public static double incoherentElectricIntensityEquivalentAtLabPoint(
+            Vec3 pointMeters, List<JonesGaussianBeam> beams) {
+        if (pointMeters == null) throw new IllegalArgumentException("sample point required");
+        validateNonemptyUniqueBeams(beams);
+        Set<String> groups = new HashSet<>();
+        double sum = 0;
+        for (JonesGaussianBeam beam : beams) {
+            if (!groups.add(beam.phaseReferenceKey())) {
+                throw new IllegalArgumentException("shared phase reference must not be silently summed incoherently");
+            }
+            sum += beam.sampleAtLabPoint(pointMeters).electricIntensityEquivalentWattsPerSquareMeter();
+        }
+        if (!Double.isFinite(sum)) throw new ArithmeticException("incoherent intensity overflow");
+        return sum;
+    }
+
+    private static void validateNonemptyUniqueBeams(List<JonesGaussianBeam> beams) {
+        if (beams == null || beams.isEmpty()) {
+            throw new IllegalArgumentException("at least one beam required");
+        }
+        Set<String> ids = new HashSet<>();
+        for (JonesGaussianBeam beam : beams) {
+            if (beam == null || !ids.add(beam.beamId())) {
+                throw new IllegalArgumentException("null or duplicate physical beam ID");
+            }
+        }
+    }
+}
--- D5/physics-core/src/main/java/dev/coldatomcraft/physics/optics/ComplexAmplitude.java
+++ D6/physics-core/src/main/java/dev/coldatomcraft/physics/optics/ComplexAmplitude.java
@@ -0,0 +1,63 @@
+package dev.coldatomcraft.physics.optics;
+
+/**
+ * Finite dimensionless complex arithmetic (or a complex optical phasor when
+ * paired with explicit units). No carrier-frequency, power or time semantics
+ * are attached to this value itself.
+ */
+public record ComplexAmplitude(double real, double imaginary) {
+    public static final ComplexAmplitude ZERO = new ComplexAmplitude(0, 0);
+    public static final ComplexAmplitude ONE = new ComplexAmplitude(1, 0);
+    public static final ComplexAmplitude I = new ComplexAmplitude(0, 1);
+
+    public ComplexAmplitude {
+        if (!Double.isFinite(real) || !Double.isFinite(imaginary)) {
+            throw new IllegalArgumentException("complex amplitude components must be finite");
+        }
+        if (real == 0) real = 0.0;
+        if (imaginary == 0) imaginary = 0.0;
+    }
+
+    public static ComplexAmplitude fromPhaseRadians(double phaseRadians) {
+        if (!Double.isFinite(phaseRadians)) {
+            throw new IllegalArgumentException("finite phase required");
+        }
+        // Avoid direct sin/cos evaluation on a large input. This does not
+        // restore phase detail already lost in the caller's input double.
+        double phase = Math.IEEEremainder(phaseRadians, 2 * Math.PI);
+        return new ComplexAmplitude(Math.cos(phase), Math.sin(phase));
+    }
+
+    public ComplexAmplitude plus(ComplexAmplitude other) {
+        if (other == null) throw new IllegalArgumentException("other required");
+        return new ComplexAmplitude(real + other.real, imaginary + other.imaginary);
+    }
+
+    public ComplexAmplitude minus(ComplexAmplitude other) {
+        if (other == null) throw new IllegalArgumentException("other required");
+        return new ComplexAmplitude(real - other.real, imaginary - other.imaginary);
+    }
+
+    public ComplexAmplitude times(ComplexAmplitude other) {
+        if (other == null) throw new IllegalArgumentException("other required");
+        return new ComplexAmplitude(
+                Math.fma(real, other.real, -imaginary * other.imaginary),
+                Math.fma(real, other.imaginary, imaginary * other.real));
+    }
+
+    public ComplexAmplitude scale(double scalar) {
+        if (!Double.isFinite(scalar)) throw new IllegalArgumentException("finite scalar required");
+        return new ComplexAmplitude(real * scalar, imaginary * scalar);
+    }
+
+    public ComplexAmplitude conjugate() {
+        return new ComplexAmplitude(real, -imaginary);
+    }
+
+    public double magnitudeSquared() {
+        double magnitude = Math.hypot(real, imaginary);
+        double square = magnitude * magnitude;
+        if (!Double.isFinite(square)) throw new ArithmeticException("phasor intensity overflow");
+        return square;
+    }
+}
--- D5/physics-core/src/main/java/dev/coldatomcraft/physics/optics/JonesGaussianBeam.java
+++ D6/physics-core/src/main/java/dev/coldatomcraft/physics/optics/JonesGaussianBeam.java
@@ -0,0 +1,90 @@
+package dev.coldatomcraft.physics.optics;
+
+import dev.coldatomcraft.physics.Vec3;
+
+/**
+ * A fully polarized CW Gaussian beam, as a complex electric-field reference.
+ * Source power and Gaussian spatial mode come from {@link GaussianBeam}.
+ * Jones amplitudes are in a local right-handed frame (x, k x x, k), with
+ * |J|^2 <= 1 to represent passive uniform polarization optics. The beam's
+ * actual optical power after Jones attenuation is P_source * |J|^2.
+ *
+ * <p>All beams with a common phaseReferenceKey MUST have the same optical
+ * carrier frequency and a phaseAtWaistRadians expressed against the same
+ * physical time/phase origin. The string is a declaration, NOT proof of laser
+ * coherence or an Owner physics approval. It is never accepted as a world
+ * mutation authority.</p>
+ *
+ * <p>Valid only for monochromatic scalar-paraxial TEM00 spatial profiles
+ * with transverse Jones polarization. The phase at the waist is a supplied
+ * optical phase, not inferred from a Minecraft laser port.</p>
+ */
+public record JonesGaussianBeam(String beamId,
+                                String phaseReferenceKey,
+                                GaussianBeam beam,
+                                Vec3 transverseXAxisLab,
+                                JonesVector jones,
+                                double phaseAtWaistRadians) {
+    public JonesGaussianBeam {
+        if (beamId == null || beamId.isBlank() || phaseReferenceKey == null
+                || phaseReferenceKey.isBlank()) {
+            throw new IllegalArgumentException("nonempty beam ID and shared phase reference required");
+        }
+        if (beam == null || transverseXAxisLab == null || jones == null
+                || !Double.isFinite(phaseAtWaistRadians)) {
+            throw new IllegalArgumentException("beam, Jones field, basis and finite phase required");
+        }
+        transverseXAxisLab = transverseXAxisLab.normalized();
+        if (Math.abs(transverseXAxisLab.dot(beam.directionLab())) > 1e-12) {
+            throw new IllegalArgumentException("transverse X must be perpendicular to beam direction");
+        }
+        double fraction = jones.squaredNorm();
+        if (fraction > 1 + 1e-12) {
+            throw new IllegalArgumentException("reference only supports passive Jones amplitudes");
+        }
+        phaseAtWaistRadians = Math.IEEEremainder(phaseAtWaistRadians, 2 * Math.PI);
+    }
+
+    public Vec3 transverseYAxisLab() {
+        return beam.directionLab().cross(transverseXAxisLab).normalized();
+    }
+
+    /** Optical power remaining after the uniform Jones element(s). */
+    public double transmittedPowerWatts() {
+        return beam.powerWatts() * jones.squaredNorm();
+    }
+
+    /**
+     * Electric phasor at a laboratory point in normalized sqrt(W/m^2) units.
+     * Standard Gaussian phase: kz + k*r^2/(2R) - Gouy + phaseAtWaist.
+     * Time convention is exp(-i omega t). Relative phases must share a
+     * physical reference, not merely similar numerical wavelengths.
+     */
+    public VectorFieldPhasor sampleAtLabPoint(Vec3 labPointMeters) {
+        if (labPointMeters == null) throw new IllegalArgumentException("lab point required");
+        Vec3 displacement = labPointMeters.subtract(beam.waistPositionLabMeters());
+        double z = displacement.dot(beam.directionLab());
+        double r = displacement.subtract(beam.directionLab().scale(z)).magnitude();
+        double sqrtIrradiance = Math.sqrt(beam.intensityWattsPerSquareMeter(r, z));
+        if (sqrtIrradiance == 0 || jones.squaredNorm() == 0) {
+            return VectorFieldPhasor.ZERO;
+        }
+        double wavelength = beam.vacuumWavelengthMeters();
+        // Reduce propagation phase modulo wavelength *before* multiplying by
+        // k: direct 2*pi*z/lambda has avoidable overflow/precision problems.
+        // Large position uncertainty remains a physical input limitation.
+        double carrier = 2 * Math.PI * (Math.IEEEremainder(z, wavelength) / wavelength);
+        double h = Math.hypot(z, beam.rayleighRangeMeters());
+        // k*r^2/(2R): algebraically pi*(r/lambda)*(r/h)*(z/h).
+        double curvature = Math.PI * (r / wavelength) * (r / h) * (z / h);
+        double phase = carrier + curvature - beam.gouyPhaseRadians(z) + phaseAtWaistRadians;
+        ComplexAmplitude factor = ComplexAmplitude.fromPhaseRadians(phase).scale(sqrtIrradiance);
+        ComplexAmplitude localX = jones.x().times(factor);
+        ComplexAmplitude localY = jones.y().times(factor);
+        Vec3 basisY = transverseYAxisLab();
+        return new VectorFieldPhasor(
+                localX.scale(transverseXAxisLab.x()).plus(localY.scale(basisY.x())),
+                localX.scale(transverseXAxisLab.y()).plus(localY.scale(basisY.y())),
+                localX.scale(transverseXAxisLab.z()).plus(localY.scale(basisY.z())));
+    }
+}
--- D5/physics-core/src/main/java/dev/coldatomcraft/physics/optics/JonesMatrix.java
+++ D6/physics-core/src/main/java/dev/coldatomcraft/physics/optics/JonesMatrix.java
@@ -0,0 +1,99 @@
+package dev.coldatomcraft.physics.optics;
+
+/**
+ * Jones transfer matrix of ideal thin, uniform, passive polarization optics.
+ * Applies to a single common transverse basis; does not include non-paraxial
+ * scattering, finite apertures, Fresnel coefficients or frequency conversion.
+ * Relative phase is retained. Absolute path phase is NOT inferred from
+ * a plate thickness: a separate common phase can be specified explicitly.
+ */
+public record JonesMatrix(ComplexAmplitude xx, ComplexAmplitude xy,
+                          ComplexAmplitude yx, ComplexAmplitude yy) {
+    public JonesMatrix {
+        if (xx == null || xy == null || yx == null || yy == null) {
+            throw new IllegalArgumentException("all Jones matrix coefficients required");
+        }
+    }
+
+    public static JonesMatrix identity() {
+        return new JonesMatrix(ComplexAmplitude.ONE, ComplexAmplitude.ZERO,
+                ComplexAmplitude.ZERO, ComplexAmplitude.ONE);
+    }
+
+    /** Ideal absorbing linear polarizer, its transmitted axis is at angle theta. */
+    public static JonesMatrix idealLinearPolarizer(double thetaRadians) {
+        if (!Double.isFinite(thetaRadians)) throw new IllegalArgumentException("finite angle required");
+        double c = Math.cos(thetaRadians);
+        double s = Math.sin(thetaRadians);
+        return real(c*c, c*s, c*s, s*s);
+    }
+
+    /**
+     * Ideal retarder. The axis at theta has multiplier 1; its perpendicular
+     * axis acquires relative phase +delta under exp(-i omega t) convention.
+     * Uniform, lossless optical element, without Fresnel/interface loss.
+     */
+    public static JonesMatrix idealRetarder(double thetaRadians, double deltaRadians) {
+        if (!Double.isFinite(thetaRadians) || !Double.isFinite(deltaRadians)) {
+            throw new IllegalArgumentException("finite angle and retardance required");
+        }
+        double c = Math.cos(thetaRadians);
+        double s = Math.sin(thetaRadians);
+        ComplexAmplitude e = ComplexAmplitude.fromPhaseRadians(deltaRadians);
+        ComplexAmplitude oneMinusE = ComplexAmplitude.ONE.minus(e);
+        return new JonesMatrix(
+                new ComplexAmplitude(c*c, 0).plus(e.scale(s*s)),
+                oneMinusE.scale(c*s),
+                oneMinusE.scale(c*s),
+                new ComplexAmplitude(s*s, 0).plus(e.scale(c*c)));
+    }
+
+    /**
+     * Explicit relative retardance AND common path phase. The two-argument
+     * factory chooses common phase zero as a gauge convention only; a real
+     * interferometer must supply the physically measured/calculated common
+     * phase accumulated through the plate and all other optical path elements.
+     */
+    public static JonesMatrix idealRetarder(double thetaRadians,
+                                            double deltaRadians,
+                                            double commonPhaseRadians) {
+        return idealRetarder(thetaRadians, deltaRadians)
+                .withUniformPhaseRadians(commonPhaseRadians);
+    }
+
+    /** Uniform optical-path phase multiplier; does not change Jones power. */
+    public JonesMatrix withUniformPhaseRadians(double phaseRadians) {
+        ComplexAmplitude multiplier = ComplexAmplitude.fromPhaseRadians(phaseRadians);
+        return new JonesMatrix(xx.times(multiplier), xy.times(multiplier),
+                yx.times(multiplier), yy.times(multiplier));
+    }
+
+    public static JonesMatrix quarterWave(double thetaRadians) {
+        return idealRetarder(thetaRadians, Math.PI / 2);
+    }
+
+    public static JonesMatrix halfWave(double thetaRadians) {
+        return idealRetarder(thetaRadians, Math.PI);
+    }
+
+    private static JonesMatrix real(double a, double b, double c, double d) {
+        return new JonesMatrix(new ComplexAmplitude(a, 0), new ComplexAmplitude(b, 0),
+                new ComplexAmplitude(c, 0), new ComplexAmplitude(d, 0));
+    }
+
+    public JonesVector apply(JonesVector incident) {
+        if (incident == null) throw new IllegalArgumentException("incident Jones vector required");
+        return new JonesVector(xx.times(incident.x()).plus(xy.times(incident.y())),
+                yx.times(incident.x()).plus(yy.times(incident.y())));
+    }
+
+    /** Apply this element first, then {@code following}. */
+    public JonesMatrix then(JonesMatrix following) {
+        if (following == null) throw new IllegalArgumentException("following matrix required");
+        return new JonesMatrix(
+                following.xx.times(xx).plus(following.xy.times(yx)),
+                following.xx.times(xy).plus(following.xy.times(yy)),
+                following.yx.times(xx).plus(following.yy.times(yx)),
+                following.yx.times(xy).plus(following.yy.times(yy)));
+    }
+}
--- D5/physics-core/src/main/java/dev/coldatomcraft/physics/optics/JonesVector.java
+++ D6/physics-core/src/main/java/dev/coldatomcraft/physics/optics/JonesVector.java
@@ -0,0 +1,50 @@
+package dev.coldatomcraft.physics.optics;
+
+/**
+ * Jones field amplitudes along an explicitly supplied transverse basis.
+ * The pair is NOT automatically normalized: after an ideal polarizer its
+ * squared norm is the fraction of incident optical power transmitted.
+ * For a physical input state use a unit-norm Jones vector.
+ *
+ * <p>The phasor uses exp(-i omega t) time dependence. Handedness labels for
+ * circular polarization additionally require the propagation/basis convention.</p>
+ */
+public record JonesVector(ComplexAmplitude x, ComplexAmplitude y) {
+    public JonesVector {
+        if (x == null || y == null) throw new IllegalArgumentException("both Jones components required");
+    }
+
+    public static JonesVector horizontal() {
+        return new JonesVector(ComplexAmplitude.ONE, ComplexAmplitude.ZERO);
+    }
+
+    public static JonesVector vertical() {
+        return new JonesVector(ComplexAmplitude.ZERO, ComplexAmplitude.ONE);
+    }
+
+    public static JonesVector linearRadians(double angle) {
+        if (!Double.isFinite(angle)) throw new IllegalArgumentException("finite angle required");
+        return new JonesVector(new ComplexAmplitude(Math.cos(angle), 0),
+                new ComplexAmplitude(Math.sin(angle), 0));
+    }
+
+    public double squaredNorm() {
+        double total = x.magnitudeSquared() + y.magnitudeSquared();
+        if (!Double.isFinite(total)) throw new ArithmeticException("Jones norm overflow");
+        return total;
+    }
+
+    public JonesVector times(ComplexAmplitude scalar) {
+        if (scalar == null) throw new IllegalArgumentException("complex scale required");
+        return new JonesVector(x.times(scalar), y.times(scalar));
+    }
+
+    public JonesVector scale(double scalar) {
+        return new JonesVector(x.scale(scalar), y.scale(scalar));
+    }
+
+    public JonesVector plus(JonesVector other) {
+        if (other == null) throw new IllegalArgumentException("other required");
+        return new JonesVector(x.plus(other.x), y.plus(other.y));
+    }
+}
