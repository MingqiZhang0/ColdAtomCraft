--- D8/verification/M0-R2.1-D9/verify_detector_reference.py
+++ D9/verification/M0-R2.1-D9/verify_detector_reference.py
@@ -0,0 +1,75 @@
+#!/usr/bin/env python3
+"""Independent pure-stdlib Decimal(80) reference for offset-Gaussian apertures.
+
+Java uses transformed angular integration and Gauss-Legendre nodes.
+This independently computes the noncentral-chi-square CDF using a
+Poisson/Gamma mixture (2 degrees of freedom). Not JUnit/NeoForge.
+"""
+
+from decimal import Decimal, localcontext
+from pathlib import Path
+import subprocess
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[2]
+D = Decimal
+
+
+def independent_fraction(a: Decimal, d: Decimal) -> Decimal:
+    if a < 0 or d < 0:
+        raise ValueError("nonnegative normalized dimensions required")
+    # Noncentrality lambda=4*d^2 and threshold x=4*a^2.
+    # s=lambda/2=2*d^2, t=x/2=2*a^2.
+    s, t = 2*d*d, 2*a*a
+    poisson_s = (-s).exp()
+    poisson_t = (-t).exp()
+    cumulative_t = poisson_t
+    result = D(0)
+    # Integral = sum_k Poisson(s,k) * GammaCDF(k+1,t),
+    # where GammaCDF(k+1,t) = 1 - PoissonCDF(t,k).
+    max_iterations = max(400, int(max(s,t))+500)
+    for k in range(max_iterations):
+        tail_t = 1 - cumulative_t
+        if tail_t < 0 and abs(tail_t) < D("1e-72"):
+            tail_t = D(0)
+        result += poisson_s * tail_t
+        kp1 = k+1
+        poisson_s *= s / kp1
+        poisson_t *= t / kp1
+        cumulative_t += poisson_t
+        if kp1 > s+100 and poisson_s < D("1e-75"):
+            break
+    else:
+        raise AssertionError("Poisson/Gamma decimal series did not converge")
+    return result
+
+
+def main():
+    sources=sorted(str(x) for x in (ROOT/'physics-core/src/main/java').rglob('*.java'))
+    probe=ROOT/'verification/M0-R2.1-D9/DetectorReferenceProbe.java'
+    with tempfile.TemporaryDirectory(prefix='cac-d9-optical-power-') as output:
+        subprocess.run(['javac','--release','21','-encoding','UTF-8',
+                        '-Xlint:all','-Werror','-d',output,*sources,str(probe)],check=True)
+        results=subprocess.check_output(['java','-cp',output,
+                       'dev.coldatomcraft.verification.DetectorReferenceProbe'],text=True)
+    comparisons=0
+    with localcontext() as ctx:
+        ctx.prec=80
+        for line in results.splitlines():
+            fields=line.split('|')
+            if len(fields)!=4 or fields[0]!='CASE':
+                raise AssertionError('malformed Java detector oracle row: '+line)
+            a,d,observed = map(D,fields[1:])
+            target=independent_fraction(a,d)
+            error=abs(observed-target)
+            if error>D('3e-11'):
+                raise AssertionError(f'offset disk a/w={a}, d/w={d}: Java={observed}, '
+                                     f'Decimal80={target}, error={error}')
+            comparisons+=1
+    assert comparisons == 26, comparisons
+    print(f'PASS: {comparisons}/{comparisons} independent Decimal80 offset Gaussian '
+          'aperture power checks (noncentral chi-square / Poisson-Gamma oracle); NOT JUnit')
+
+
+if __name__=='__main__':
+    main()
--- D8/verification/PowerMeterSmoke.java
+++ D9/verification/PowerMeterSmoke.java
@@ -0,0 +1,68 @@
+package dev.coldatomcraft.verification;
+
+import dev.coldatomcraft.experiment.IdealOpticalPowerMeter;
+import dev.coldatomcraft.physics.Vec3;
+import dev.coldatomcraft.physics.optics.*;
+
+/** Standalone scientific smoke, not JUnit or Minecraft runtime. */
+public final class PowerMeterSmoke {
+    private static int checks;
+    private PowerMeterSmoke() {}
+
+    private static void check(boolean condition,String message) {
+        checks++;
+        if (!condition) throw new AssertionError(message);
+    }
+    private static void close(double expected,double actual,double abs,String message) {
+        checks++;
+        if (!Double.isFinite(actual)||Math.abs(expected-actual)>abs)
+            throw new AssertionError(message+": expected="+expected+" actual="+actual);
+    }
+
+    public static void main(String[] args) {
+        double power = 0.02, w0 = 0.0005, lambda=780e-9;
+        var beam=new GaussianBeam(power,lambda,w0,new Vec3(0,0,0),new Vec3(0,0,1));
+        var waist=GaussianPlane.atAxialDistance(beam,0);
+        close(1-Math.exp(-2),GaussianCircularAperture.capturedFraction(w0,w0,0),1e-14,"centered disk");
+        var matched=GaussianCircularAperture.capture(waist,w0,0);
+        close(power*(1-Math.exp(-2)),matched.capturedPowerWatts(),1e-14,"captured watts");
+        close(power,matched.capturedPowerWatts()+matched.uncapturedPowerWatts(),1e-14,"budget");
+        var offset=GaussianCircularAperture.capture(waist,w0,w0);
+        check(offset.capturedPowerWatts()<matched.capturedPowerWatts(),"misalignment");
+        var far=new IdealCircularDetectorFace(new Vec3(0,0,4),new Vec3(0,0,-1),w0);
+        check(far.capture(beam).capturedPowerWatts()<matched.capturedPowerWatts(),"diffractive widening");
+        var face=new IdealCircularDetectorFace(new Vec3(0,0,0),new Vec3(0,0,-1),w0);
+        close(matched.capturedPowerWatts(),face.capture(beam).capturedPowerWatts(),1e-14,"3D face");
+        var meter=new IdealOpticalPowerMeter("D9-meter",w0);
+        var mode=ParaxialModeField.fromPlane("phase-reference","port-frame",waist,
+                new JonesVector(ComplexAmplitude.ONE,ComplexAmplitude.ZERO),0);
+        var reading=meter.sampleMode(mode,0,123);
+        close(matched.capturedPowerWatts(),reading.observation().value(),1e-14,"mode readout");
+        check("W".equals(reading.observation().siUnit()),"SI units");
+        check("ideal_collected_optical_power".equals(reading.observation().observable()),"explicit ideal observable");
