+                {1, 0.9}, {1, 0.99}, {1, 1}, {1, 1.001},
+                {1, 1.5}, {2, 0.5}, {2, 2}, {3, 3},
+                {6, 5.94}, {6, 6}, {6, 6.00006},
+                {10, 9.9}, {10, 10}, {10, 10.0001},
