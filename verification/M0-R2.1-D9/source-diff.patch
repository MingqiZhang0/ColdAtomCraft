+        var face=new IdealCircularDetectorFace(new Vec3(0,0,0),new Vec3(0,0,-1),0.0004);
+        var meter=new IdealOpticalPowerMeter("meter",0.0005);
+        assertThrows(IllegalArgumentException.class,()->meter.sampleAtFace(beam,face,0));
